---
import { getCollection } from 'astro:content';
import Portals from '../../components/Portals.astro';
import { formatNoteTitle, isBookReview } from '../../lib/notes';

const notes = (
  await getCollection('notes', ({ data, id }) => data.public === true && !isBookReview(id))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>Notes | Tazik</title>
  </head>
  <body>
    <main class="notes">
      <header>
        <a class="home" href="/" aria-label="home"><span class="signature"></span></a>
        <h1>Notes</h1>
      </header>
      <ul>
        {
          notes.map((note) => (
            <li>
              <a href={`/notes/${note.id}`}>{formatNoteTitle(note.data.title)}</a>
              <time datetime={note.data.date.toISOString().slice(0, 10)}>
                {note.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </li>
          ))
        }
      </ul>
      <Portals />
    </main>

    <style>
      .notes {
        max-width: 640px;
        margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
      }
      ul { list-style: none; padding: 0; margin: 0; }
      li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.5rem 0;
      }
      li a {
        font-family: 'Fraunces', serif;
        font-optical-sizing: auto;
        font-size: 1.1rem;
        color: var(--accent);
        text-decoration: none;
      }
      li a:hover { text-decoration: underline; }
      li time { font-size: 0.9rem; color: var(--muted); flex-shrink: 0; }
    </style>
  </body>
</html>
