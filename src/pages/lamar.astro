  }

  .field-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .field-notes h2 {
    margin: 0 0 0.75rem;
    color: var(--ink-strong);
    font: 500 1.15rem/1.3 'Fraunces', serif;
  }
  .field-notes p { margin: 0 0 0.6rem; color: var(--muted); font-size: 0.9rem; }
  .field-notes a { color: var(--accent); text-decoration: none; }
  .field-notes a:hover { text-decoration: underline; }
  kbd {
    display: inline-block;
    min-width: 1.7em;
    padding: 0.04rem 0.32rem;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: 4px;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    font: 0.78rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    text-align: center;
  }

  @media (max-width: 620px) {
    .lamar-page { padding-inline: 0.75rem; }
    .game-shell { border-radius: 12px; }
    .game-toolbar { align-items: flex-start; }
    .field-notes { grid-template-columns: 1fr; gap: 1.25rem; }
    .stats { gap: 0.35rem 0.7rem; }
  }

  @media (pointer: fine) and (min-width: 760px) {
    .touch-controls { padding-block: 0.55rem; }
    .touch-controls button { min-height: 2.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-shell { box-shadow: none; }
  }
</style>
