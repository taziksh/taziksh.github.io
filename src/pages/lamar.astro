<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Lamar's Space Adventures, faithfully preserved from the original Java game."
    />
    <title>Lamar's Space Adventures</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <main>
      <canvas
        id="lamar-canvas"
        width="640"
        height="500"
        tabindex="0"
        aria-label="Lamar's Space Adventures"
      >
        Your browser needs Canvas and WebAssembly to run Lamar's Space Adventures.
      </canvas>

      <aside id="info-window" role="dialog" aria-label="Info" hidden>
        <div class="window-title">Info</div>
        <div class="info-content">
          <span style="top: 0px">LAMAR'S SPACE ADVENTURES</span>
          <span style="top: 100px">Use W to move up</span>
          <span style="top: 200px">Use S to move down</span>
          <span style="top: 300px">Use Spacebar to fire</span>
          <span style="top: 400px">Use P to pause game</span>
        </div>
      </aside>

      <p id="game-status" class="visually-hidden" aria-live="polite"></p>
    </main>
    <script type="module" src="/lamar/game.js"></script>
  </body>
</html>

<style>
  * { box-sizing: border-box; }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
    background: #000;
  }

  body {
    min-height: 100dvh;
    overflow: hidden;
  }

  main {
    display: grid;
    min-height: 100dvh;
    place-items: center;
  }

  canvas {
    display: block;
    width: min(640px, 100vw);
    height: auto;
    outline: none;
  }

  #info-window {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 600px;
    border: 1px solid #777;
    color: #000;
    background: #eee;
    font: 12px Arial, sans-serif;
    box-shadow: 2px 2px 8px rgb(0 0 0 / 45%);
  }

  #info-window[hidden] { display: none; }

  .window-title {
    height: 24px;
    padding: 3px 8px;
    border-bottom: 1px solid #999;
    background: #ddd;
    font-weight: 700;
  }

  .info-content {
    position: relative;
    height: 576px;
  }

  .info-content span {
    position: absolute;
    left: 0;
    width: 250px;
    height: 100px;
    padding-left: 4px;
    line-height: 100px;
    white-space: nowrap;
  }

  .visually-hidden {
    position: fixed;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
