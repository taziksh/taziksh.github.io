---
const pieces = [
  { src: '/art/brush-3.jpg', width: 1600, height: 2131 },
  { src: '/art/doodles.jpg', width: 768, height: 744 },
  { src: '/art/desserts.webp', width: 1280, height: 2276 },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>Art | Tazik</title>
  </head>
  <body>
    <main class="art">
      <header>
        <a class="home" href="/" aria-label="home"><span class="signature"></span></a>
        <h1>Art</h1>
      </header>
      <div class="viewer">
        <button class="arrow prev" aria-label="previous">&lsaquo;</button>
        <div class="stage">
          {
            pieces.map((piece, i) => (
              <img
                class:list={['piece', { active: i === 0 }]}
                src={piece.src}
                width={piece.width}
                height={piece.height}
                alt=""
              />
            ))
          }
        </div>
        <button class="arrow next" aria-label="next">&rsaquo;</button>
      </div>
      <div class="strip">
        {
          pieces.map((piece, i) => (
            <button class:list={['thumb', { active: i === 0 }]} data-index={i} aria-label={`piece ${i + 1}`}>
              <img src={piece.src} alt="" />
            </button>
          ))
        }
      </div>
    </main>

    <script>
      const pieces = document.querySelectorAll('.piece');
      const thumbs = document.querySelectorAll('.thumb');
      let current = 0;

      function show(index) {
        current = (index + pieces.length) % pieces.length;
        pieces.forEach((p, i) => p.classList.toggle('active', i === current));
        thumbs.forEach((t, i) => t.classList.toggle('active', i === current));
      }

      document.querySelector('.prev').addEventListener('click', () => show(current - 1));
      document.querySelector('.next').addEventListener('click', () => show(current + 1));
      thumbs.forEach((t) =>
        t.addEventListener('click', () => show(Number(t.dataset.index)))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    </script>

    <style>
      .art {
        max-width: 880px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
      }
      .viewer {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.5rem;
      }
      .stage { min-height: 60vh; display: grid; place-items: center; }
      .piece {
        display: none;
        max-width: 100%;
        max-height: 72vh;
        width: auto;
        height: auto;
        border-radius: 6px;
      }
      .piece.active { display: block; }
      .arrow {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 2.4rem;
        line-height: 1;
        color: var(--muted);
        padding: 0.5rem 0.75rem;
        font-family: 'Fraunces', serif;
      }
      .arrow:hover { color: var(--accent); }
      .strip {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 1.5rem;
      }
      .thumb {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        border-radius: 4px;
        overflow: hidden;
        opacity: 0.45;
      }
      .thumb:hover { opacity: 0.8; }
      .thumb.active {
        opacity: 1;
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      .thumb img {
        display: block;
        width: 44px;
        height: 60px;
        object-fit: cover;
      }
    </style>
  </body>
</html>
