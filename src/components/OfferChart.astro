---
const VIEW_W = 640;
const VIEW_H = 400;
const PAD = { left: 62, right: 22, top: 28, bottom: 58 };
const N_MIN = 1;
const N_MAX = 1000;
const P_MAX = 20;
const SAMPLES = 180;
const DEFAULT_P = 5;
const DEFAULT_N = 60;
const LEVELS = [
  { value: 0.5, label: '50% chance', labelN: 12 },
  { value: 0.9, label: '90% chance', labelN: 42 },
];
const X_TICKS = [1, 10, 100, 1000];
const Y_TICKS = [0, 5, 10, 15, 20];

const plotW = VIEW_W - PAD.left - PAD.right;
const plotH = VIEW_H - PAD.top - PAD.bottom;
const baseY = VIEW_H - PAD.bottom;
const logNSpan = Math.log(N_MAX / N_MIN);
const sx = (n: number) => PAD.left + (Math.log(n / N_MIN) / logNSpan) * plotW;
const sy = (p: number) => PAD.top + (1 - p / P_MAX) * plotH;
const chance = (p: number, n: number) => 1 - Math.pow(1 - p / 100, n);
const contourP = (level: number, n: number) =>
  n === 0 ? Number.POSITIVE_INFINITY : (1 - Math.pow(1 - level, 1 / n)) * 100;

function contourPoints(level: number) {
  const points: Array<{ x: number; y: number }> = [];
  for (let i = 0; i <= SAMPLES; i++) {
    const n = N_MIN * Math.exp((i / SAMPLES) * logNSpan);
    const p = contourP(level, n);
    if (p <= P_MAX) points.push({ x: sx(n), y: sy(p) });
  }
  return points;
}

function contourPath(level: number, labelN: number) {
  const labelX = sx(labelN);
  const labelY = sy(contourP(level, labelN)) - 11;
  let pen = false;
  return contourPoints(level)
    .map(({ x, y }) => {
      if (Math.abs(x - labelX) < 38 && Math.abs(y - labelY) < 12) { pen = false; return ''; }
      const cmd = pen ? 'L' : 'M';
      pen = true;
      return `${cmd}${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .filter(Boolean)
    .join('');
}

const cfg = {
  viewW: VIEW_W,
  viewH: VIEW_H,
  nMin: N_MIN,
  nMax: N_MAX,
  pMax: P_MAX,
  ...PAD,
};
const defaultChance = chance(DEFAULT_P, DEFAULT_N);
const dx = sx(DEFAULT_N);
const dy = sy(DEFAULT_P);
---

<figure class="offer-chart" data-offer-chart data-cfg={JSON.stringify(cfg)}>
  <div class="plot-wrap">
  <svg
    class="plot"
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    role="img"
    tabindex="0"
    aria-labelledby="offer-chart-title offer-chart-description"
  >
    <title id="offer-chart-title">Chance of at least one job offer</title>
    <desc id="offer-chart-description">
      An interactive contour plot. Applications from one to one thousand are on a logarithmic
      horizontal axis and success per application is on the vertical axis. Drag, click, or use the
      arrow keys to change both values.
    </desc>

    <g class="tick-marks" aria-hidden="true">
      {
        Y_TICKS.map((tick) => (
          <line x1={PAD.left} y1={sy(tick)} x2={PAD.left + 4} y2={sy(tick)} />
        ))
      }
      {
        X_TICKS.map((tick) => (
          <line x1={sx(tick)} y1={baseY} x2={sx(tick)} y2={baseY - 4} />
        ))
      }
    </g>

    <rect
      class="plot-frame"
      x={PAD.left}
      y={PAD.top}
      width={plotW}
      height={plotH}
      aria-hidden="true"
    />

    <g class="contours" aria-hidden="true">
      {
        LEVELS.map((level) => (
          <>
            <path d={contourPath(level.value, level.labelN)} />
            <text
              x={sx(level.labelN)}
              y={sy(contourP(level.value, level.labelN)) - 7}
              text-anchor="middle"
            >
              {level.label}
            </text>
          </>
        ))
      }
    </g>

    <g class="ticks" aria-hidden="true">
      {
        Y_TICKS.map((tick) => (
          <text x={PAD.left - 10} y={sy(tick) + 4} text-anchor="end">{tick}%</text>
        ))
      }
      {
        X_TICKS.map((tick) => (
          <text x={sx(tick)} y={baseY + 21} text-anchor="middle">{tick}</text>
        ))
      }
        <text class="x-label" x={PAD.left + plotW / 2} y={VIEW_H - 10} text-anchor="middle">
          applications, <tspan class="math-variable">n</tspan>
      </text>
      <text
        class="y-label"
        x="16"
        y={PAD.top + plotH / 2}
        text-anchor="middle"
        transform={`rotate(-90 16 ${PAD.top + plotH / 2})`}
      >
          success per application, <tspan class="math-variable">p</tspan>
      </text>
    </g>

    <g class="selection" aria-hidden="true">
      <line class="guide guide-x" x1={PAD.left} y1={dy} x2={dx} y2={dy} />
      <line class="guide guide-y" x1={dx} y1={dy} x2={dx} y2={baseY} />
      <circle class="dot" cx={dx} cy={dy} r="6" />
    </g>

    <rect
      class="hit-area"
      x={PAD.left}
      y={PAD.top}
      width={plotW}
      height={plotH}
      aria-hidden="true"
    />
  </svg>
    <output class="plot-result" aria-live="polite">{(defaultChance * 100).toFixed(1)}%</output>
  </div>

  <figcaption class="readout">
    <label>
      <span class="math-variable">n</span> =
      <input
        class="n-input"
        type="number"
        min={N_MIN}
        max={N_MAX}
        step="1"
        value={DEFAULT_N}
        aria-label="applications"
      />
    </label>
    <label>
      <span class="math-variable">p</span> =
      <input
        class="p-input"
        type="number"
        min="0"
        max={P_MAX}
        step="1"
        value={DEFAULT_P}
        aria-label="success per application"
      />
      <span class="unit">%</span>
    </label>
  </figcaption>
</figure>

<style>
  .offer-chart {
    margin: 2.8em 0;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    color: color-mix(in srgb, var(--ink) 68%, var(--bg));
    font-size: 0.72rem;
    line-height: 1.35;
  }
  .readout label {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
  }
  .math-variable {
    color: var(--ink);
    font-family: 'KaTeX_Math', 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
  }
  .plot {
    display: block;
    width: 100%;
    height: auto;
    outline: none;
    touch-action: none;
    user-select: none;
  }
  .plot-wrap {
    position: relative;
  }
  .plot-result {
    position: absolute;
    top: 11%;
    right: 5.5%;
    color: var(--ink-strong);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }
  .plot:focus-visible .plot-frame {
    stroke: var(--ink-strong);
    stroke-width: 2;
  }
  .tick-marks line {
    stroke: var(--muted);
    stroke-width: 0.5;
  }
  .plot-frame {
    fill: transparent;
    stroke: var(--muted);
    stroke-width: 0.5;
  }
  .contours path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
  }
  .contours text {
    fill: color-mix(in srgb, var(--ink) 68%, var(--bg));
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-rendering: geometricPrecision;
  }
  .ticks text {
    fill: color-mix(in srgb, var(--ink) 68%, var(--bg));
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .ticks .x-label,
  .ticks .y-label {
    fill: var(--ink);
    font-size: 10px;
  }
  .guide {
    stroke: var(--muted);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .dot {
    fill: var(--ink-strong);
  }
  .hit-area {
    fill: transparent;
    cursor: crosshair;
    pointer-events: all;
  }
  .readout input {
    box-sizing: border-box;
    width: 4.5rem;
    height: 1.75rem;
    padding: 0.18rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    border-radius: 5px;
    outline: none;
    background: var(--bg);
    color: var(--ink-strong);
    font: 600 0.76rem/1 'Inter', system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .readout input:focus {
    border-color: var(--ink-strong);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--ink-strong) 14%, transparent);
  }
  .unit {
    color: color-mix(in srgb, var(--ink) 68%, var(--bg));
    font-size: 0.68rem;
  }
  @media (max-width: 520px) {
    .offer-chart {
      margin-right: -0.25rem;
      margin-left: -0.25rem;
    }
    .contours text {
      font-size: 14px;
    }
    .ticks text,
    .ticks .x-label,
    .ticks .y-label {
      font-size: 13px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot,
    .guide {
      transition: cx 80ms linear, cy 80ms linear, x1 80ms linear, x2 80ms linear,
        y1 80ms linear, y2 80ms linear;
    }
    .offer-chart.is-dragging .dot,
    .offer-chart.is-dragging .guide {
      transition: none;
    }
  }
</style>

<script>
  type Cfg = {
    viewW: number;
    viewH: number;
    nMin: number;
    nMax: number;
    pMax: number;
    left: number;
    right: number;
    top: number;
    bottom: number;
  };

  document.querySelectorAll<HTMLElement>('[data-offer-chart]').forEach((root) => {
    const c: Cfg = JSON.parse(root.dataset.cfg!);
    const plotW = c.viewW - c.left - c.right;
    const plotH = c.viewH - c.top - c.bottom;
    const baseY = c.viewH - c.bottom;
    const logNSpan = Math.log(c.nMax / c.nMin);
    const sx = (n: number) => c.left + (Math.log(n / c.nMin) / logNSpan) * plotW;
    const sy = (p: number) => c.top + (1 - p / c.pMax) * plotH;
    const chance = (p: number, n: number) => 1 - Math.pow(1 - p / 100, n);
    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const plot = root.querySelector<SVGSVGElement>('.plot')!;
    const hitArea = root.querySelector<SVGRectElement>('.hit-area')!;
    const guideX = root.querySelector<SVGLineElement>('.guide-x')!;
    const guideY = root.querySelector<SVGLineElement>('.guide-y')!;
    const dot = root.querySelector<SVGCircleElement>('.dot')!;
    const result = root.querySelector<HTMLOutputElement>('.plot-result')!;
    const nInput = root.querySelector<HTMLInputElement>('.n-input')!;
    const pInput = root.querySelector<HTMLInputElement>('.p-input')!;
    let dragging = false;

    function render() {
      const n = clamp(Math.round(Number(nInput.value) || c.nMin), c.nMin, c.nMax);
      const p = clamp(Math.round(Number(pInput.value) || 0), 0, c.pMax);
      const x = sx(n);
      const y = sy(p);
      const probability = `${(chance(p, n) * 100).toFixed(1)}%`;

      nInput.value = `${n}`;
      pInput.value = `${p}`;
      result.textContent = probability;

      dot.setAttribute('cx', `${x}`);
      dot.setAttribute('cy', `${y}`);
      guideX.setAttribute('x1', `${c.left}`);
      guideX.setAttribute('x2', `${x}`);
      guideX.setAttribute('y1', `${y}`);
      guideX.setAttribute('y2', `${y}`);
      guideY.setAttribute('x1', `${x}`);
      guideY.setAttribute('x2', `${x}`);
      guideY.setAttribute('y1', `${y}`);
      guideY.setAttribute('y2', `${baseY}`);
      plot.setAttribute(
        'aria-label',
        `${n} applications at ${p}% success each gives a ${probability} chance of at least one offer. Use arrow keys to adjust.`
      );
    }

    function updateFromPointer(event: PointerEvent) {
      const bounds = plot.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width) * c.viewW;
      const y = ((event.clientY - bounds.top) / bounds.height) * c.viewH;
      const nRatio = clamp((x - c.left) / plotW, 0, 1);
      nInput.value = `${Math.round(c.nMin * Math.exp(nRatio * logNSpan))}`;
      pInput.value = `${Math.round(clamp((1 - (y - c.top) / plotH) * c.pMax, 0, c.pMax))}`;
      render();
    }

    hitArea.addEventListener('pointerdown', (event) => {
      dragging = true;
      root.classList.add('is-dragging');
      hitArea.setPointerCapture(event.pointerId);
      plot.focus();
      updateFromPointer(event);
    });
    hitArea.addEventListener('pointermove', (event) => {
      if (dragging) updateFromPointer(event);
    });
    hitArea.addEventListener('pointerup', (event) => {
      dragging = false;
      root.classList.remove('is-dragging');
      hitArea.releasePointerCapture(event.pointerId);
    });
    hitArea.addEventListener('pointercancel', () => {
      dragging = false;
      root.classList.remove('is-dragging');
    });

    plot.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 5 : 1;
      if (event.key === 'ArrowLeft') nInput.value = `${Number(nInput.value) - step}`;
      else if (event.key === 'ArrowRight') nInput.value = `${Number(nInput.value) + step}`;
      else if (event.key === 'ArrowDown') pInput.value = `${Number(pInput.value) - step}`;
      else if (event.key === 'ArrowUp') pInput.value = `${Number(pInput.value) + step}`;
      else return;

      event.preventDefault();
      render();
    });

    nInput.addEventListener('input', render);
    pInput.addEventListener('input', render);
    render();
  });
</script>
